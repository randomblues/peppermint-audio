# Add a real Resend API key locally; never commit it to this file.
RESEND_API_KEY=re_placeholder
CRON_SECRET=use-a-long-random-secret-for-vercel-cron
# onboarding@resend.dev can only deliver to the Resend account email until a domain is verified.
ENQUIRY_FROM_EMAIL=Peppermint Audio <onboarding@resend.dev>
ENQUIRY_TO_EMAIL=you@example.com

# Google Ads conversion tracking (public values; leave blank until configured)
NEXT_PUBLIC_GOOGLE_ADS_CONVERSION_ID=
NEXT_PUBLIC_GOOGLE_ADS_CONVERSION_LABEL=
NEXT_PUBLIC_GOOGLE_ADS_WHATSAPP_CONVERSION_LABEL=
NEXT_PUBLIC_GOOGLE_ADS_BOOKING_CONVERSION_LABEL=
NEXT_PUBLIC_GOOGLE_ADS_PHONE_CONVERSION_LABEL=

# Google Calendar OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=https://www.peppermintaudio.com.au/api/google-calendar/callback
GOOGLE_CALENDAR_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary
# Leave blank locally (calendar creation is disabled outside production); set true to opt in.
GOOGLE_CALENDAR_ENABLED=

# Supabase (all values are server-side; service role key is secret)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (server-only secret and webhook signing secret)
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxx
# Safe to expose in the browser; use the matching test/live key for the deployment.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxx

# Bank transfer details included in automated invoices
BANK_TRANSFER_ACCOUNT_NAME=Peppermint Audio
BANK_TRANSFER_BSB=
BANK_TRANSFER_ACCOUNT_NUMBER=
BANK_TRANSFER_PAYID=
